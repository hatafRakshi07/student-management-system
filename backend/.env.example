# ==============================================================================
# STUDENT MANAGEMENT SYSTEM / COLLEGE ERP - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

# Server Environment (production / staging / development)
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-random-32char-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_DEMO_AUTH=false

# Database Configuration (PostgreSQL / Supabase)
# For Supabase pooler use port 6543; direct connection uses 5432
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase API & Cloud Object Storage (Optional)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=sms-uploads

# Redis Distributed Cache & Token Blacklist (Optional)
REDIS_URL=redis://localhost:6379/0

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# AI Services (NVIDIA NIM / Google Gemini) (Optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_API_KEY=

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS & Allowed Origins (Comma-separated)
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,http://localhost:5173
