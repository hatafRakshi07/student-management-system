# Production Environment Variables Configuration Template
APP_NAME=Student Management System
APP_VERSION=1.0.0
DEBUG=false

# Security
SECRET_KEY=PROD_CHANGE_THIS_TO_A_SUPER_SECURE_RANDOMLY_GENERATED_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:production_password@db.supabase.co:5432/postgres

# Email SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@yourdomain.com
SMTP_PASSWORD=your_encrypted_smtp_app_password
SMTP_FROM=notifications@yourdomain.com

# AI & Storage Integrations
GEMINI_API_KEY=your_production_gemini_api_key
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Uploads & Allowed CORS Origins
UPLOAD_DIR=uploads
FRONTEND_URL=https://your-production-app.domain.com
