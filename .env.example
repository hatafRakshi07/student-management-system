# ── Student Management System — Environment Configuration Template ───
# Copy this file to .env and replace all placeholder values before running.

APP_NAME=Student Management System
DEBUG=False

# Generate a strong 32+ character random secret using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-strong-random-32char-secret-key-in-production

# Enable demo bypass authentication (WARNING: MUST be False in production!)
ENABLE_DEMO_AUTH=false

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────
# Production URL (use Supabase Connection Pooler on port 6543 for serverless/high concurrency)
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase API & Cloud Object Storage ──────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=sms-uploads

# ── Redis (Distributed Caching, Rate Limiting & Token Blacklisting) ───
# e.g., rediss://default:[password]@[endpoint]:6379 or redis://localhost:6379/0
REDIS_URL=

# ── Email (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=noreply@yourdomain.com

# ── AI Providers (NVIDIA NIM & Google Gemini) ────────────────────────
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GEMINI_API_KEY=your-gemini-api-key

# ── File Uploads (Fallback when cloud storage is disabled) ────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ── CORS & Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api
